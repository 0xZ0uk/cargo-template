{
  "name": "shipment",
  "private": true,
  "description": "Shipment: Payload CMS + TanStack Start template on Cloudflare Workers, and its in-house Payload plugins",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@shipment/web...",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "web": "pnpm --filter @shipment/web"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^9 || ^10 || ^11 || ^12"
  }
}
