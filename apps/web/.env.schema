# Env schema for this project. See https://varlock.dev/env-spec
#
# Values load from (lowest to highest precedence): this file, `.env.local`,
# `.env.[APP_ENV]`, `.env.[APP_ENV].local`, then the process environment.
# Keep local values in `.env.development.local` (gitignored) so they never reach a
# production deploy.
#
# @currentEnv=$APP_ENV
# @defaultSensitive=false
# @defaultRequired=false
# @generateTsTypes(path=env.d.ts)
# ---

# Selects which `.env.[APP_ENV]` files load. `pnpm deploy` sets it to `production`.
# @type=enum(development, production)
APP_ENV=development

# Signs Payload auth tokens and encrypts sensitive fields. Generate with
# `openssl rand -hex 32`. `varlock-wrangler deploy` uploads it as a Worker secret.
# Leak detection is production-only: in dev, React's server component debug info serializes
# props, and Payload's admin views pass the `payload` instance (config included) as a prop.
# @required @sensitive={preventLeaks=forEnv(production)}
PAYLOAD_SECRET=

# @type=enum(fatal, error, warn, info, debug, trace)
PAYLOAD_LOG_LEVEL=info

# Public origin of the site, without a trailing slash (e.g. https://example.com). The SEO
# analyzer uses it for sitemap.xml, robots.txt, canonical and JSON-LD URLs. Leave empty in
# dev; set it in `.env.production`.
# @type=url
SITE_URL=

# Set to 1 to serve `/llms.txt` (SEO analyzer); it returns 404 otherwise.
# @type=enum(0, 1)
SEO_LLMS_TXT=0

# SEO analyzer caps on whole-site scans. Leave empty for the plugin defaults: the dashboard
# audit stops at 5000 docs, other scans (sitemap audit, sitemap.xml…) at 5000 too. The audit
# builds in steps of 800 docs (SEO_AUDIT_STEP_DOCS, ~8 s CPU each on a deployed Worker): the
# dashboard's polls and the Cron Trigger run the steps. See the SEO analyzer README (Performance).
# @type=number
SEO_AUDIT_MAX_DOCS=
# @type=number
SEO_AUDIT_STEP_DOCS=
# @type=number
SEO_FETCH_MAX_DOCS=

# Google Search Console OAuth client (SEO analyzer, `features.gscApi`, off in this template).
# Create an OAuth client in Google Cloud, enable the Search Console API and register the
# redirect URI `<SITE_URL>/api/seo-plugin/gsc/callback` (`GET /api/seo-plugin/gsc/status`
# prints the exact value; without SITE_URL it uses the request's origin). The refresh token is
# stored encrypted in D1 (AES-256-GCM through WebCrypto).
GSC_OAUTH_CLIENT_ID=
# @sensitive
GSC_OAUTH_CLIENT_SECRET=

# Optional key for the stored GSC refresh token: 32 bytes as hex (`openssl rand -hex 32`) or
# base64. Unset, the key derives from PAYLOAD_SECRET and rotating that secret forces a GSC
# reconnect. Changing this key does the same.
# @sensitive
SEO_GSC_ENCRYPTION_KEY=

# SEO analyzer AI features (`features.aiFeatures`): meta optimize (single and bulk), rewrite,
# image alt text and content briefs, through OpenRouter. Without a key, meta suggestions fall
# back to heuristics and alt text / briefs answer `no_api_key`. Set a credit limit on the key
# in OpenRouter: that's the hard cap on spend (the plugin's rate limits are only a brake).
# @sensitive
OPENROUTER_API_KEY=

# OpenRouter model id (default `deepseek/deepseek-v4.1-flash`). It must support structured
# outputs, and image input for alt text.
SEO_AI_MODEL=

# Optional: OpenRouter's API through a proxy, e.g. Cloudflare AI Gateway
# (`https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/openrouter`). Default:
# https://openrouter.ai/api/v1.
# @type=url
SEO_AI_BASE_URL=

# Reasoning effort (default `none`: short, well-specified tasks). Set `low` or higher only for
# a model that can't turn reasoning off.
# @type=enum(none, minimal, low, medium, high)
SEO_AI_REASONING=

# `deny` (default) keeps prompts (page content, drafts included) away from providers that
# store or train on them. `allow` widens routing.
# @type=enum(deny, allow)
SEO_AI_DATA_COLLECTION=

# SEO analyzer external-links checker (off by default): unique URLs checked per scan
# (default 100). A scan that doesn't fit one request answers `partial: true` and continues
# from saved results on the next call. See the SEO analyzer README (Status on Workers).
# @type=number
SEO_EXTERNAL_LINKS_MAX=

# Subrequests one external-links request may spend on checks (default 1000). Every fetch,
# redirect hop and DNS lookup counts; Workers allow 10,000 per invocation on the paid plan and
# 50 on Free (use about 30 there, with SEO_EXTERNAL_LINKS_MAX around 10).
# @type=number
SEO_EXTERNAL_LINKS_MAX_SUBREQUESTS=

# Google PageSpeed Insights API key (SEO analyzer, Core Web Vitals in /admin/performance).
# Effectively required on a deployed Worker: without a key PSI uses a shared keyless quota
# that usually answers 429. Create one in Google Cloud: enable the "PageSpeed Insights API",
# then create an API key restricted to that API. Empty is allowed (the panel then says why
# it fails).
# @sensitive
PAGESPEED_API_KEY=

# SEO analyzer alerts digest (`alerts` feature): a daily summary of score drops, new 404s and
# ranking drops, sent by the `seoAlertsDigest` job (04:00 UTC) or "Send now" in
# /admin/performance. Nothing is sent without a channel. The webhook gets a JSON POST
# (`{ type: "seo-alert-digest", siteUrl, digest }`, or a message for Slack / Discord, see
# SEO_ALERT_WEBHOOK_FORMAT). Webhook URLs usually embed a token.
# @sensitive @type=url
SEO_ALERT_WEBHOOK_URL=

# Webhook body: `json` (the plugin's payload), `slack` or `discord`. Empty: guessed from the URL's
# host (hooks.slack.com, discord.com/api/webhooks/), else `json`.
# @type=enum(json, slack, discord)
SEO_ALERT_WEBHOOK_FORMAT=

# Comma-separated recipients. Needs an email adapter in the Payload config (none here yet).
# @sensitive
SEO_ALERT_EMAIL=

# Score drop (points, default 10) and ranking drop (positions, default 5) that count as an
# issue, and the window for new 404s (hours, default 24).
# @type=number
SEO_ALERT_SCORE_DROP=
# @type=number
SEO_ALERT_POSITION_DROP=
# @type=number
SEO_ALERT_WINDOW_HOURS=

# Socials plugin (`@cargo/payload-plugin-socials`, Pinterest only for now). It stays disabled
# (no endpoints or jobs, and an admin notice; the schema is unchanged) until the encryption key is set. 32 bytes
# as hex (`openssl rand -hex 32`) or base64. It seals the platform tokens stored in D1 with
# AES-256-GCM, so it must stay the same across deploys: a key that can't read the stored tokens
# means every platform has to be reconnected. To rotate, set the new key here and move the old one
# to SOCIALS_PREVIOUS_ENCRYPTION_KEYS; tokens are re-sealed with the new key as they are read, and
# once they have been, the old key can go. Without it the plugin is off: no endpoints or jobs,
# and its admin shows a notice. The import map and the schema are the same either way, so it is
# only needed at runtime (the Worker secret), not when building.
# @sensitive
SOCIALS_ENCRYPTION_KEY=

# Comma-separated old keys (same format) that can still read stored tokens during a rotation.
# @sensitive
SOCIALS_PREVIOUS_ENCRYPTION_KEYS=

# Pinterest app credentials (https://developers.pinterest.com/apps/). Pinterest is enabled once
# both are set, together with SOCIALS_ENCRYPTION_KEY and SITE_URL. Register this OAuth redirect
# URI on the Pinterest app: `<SITE_URL>/api/socials/pinterest/oauth/callback`. Then connect the
# account in /admin/socials.
PINTEREST_APP_ID=
# @sensitive
PINTEREST_APP_SECRET=

# A/B results in the admin (Variants panel), read from Workers Analytics Engine's SQL API.
# Impressions and conversions are written through the `AB_ANALYTICS` binding (wrangler.jsonc)
# either way; these two only let the admin read them back. Without both, the panel says
# measurement isn't configured and nothing else changes. Create a Cloudflare API token with
# the "Account Analytics: Read" permission (nothing else) for this account. Both are read on
# the server only.
AB_ANALYTICS_ACCOUNT_ID=
# @sensitive
AB_ANALYTICS_API_TOKEN=
