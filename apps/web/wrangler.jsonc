{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cargo-template",
  // Custom server entry: TanStack Start's `fetch` plus a `scheduled` handler for the cron below.
  "main": "src/server.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // Runs the scheduled Payload jobs (`scheduled` in src/server.ts). Every 5 minutes matches
  // the SEO analyzer's `auditCron`, which continues dashboard audits that paused between
  // steps; the other tasks have their own schedules on top of it.
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "cargo-template",
      // The template's own database. Replace it with yours (see README > Deployment).
      "database_id": "29e40af9-e230-4c28-a622-c337ca02fbf4",
      // Lets `pnpm migrate:remote` reach the real database. Local dev and `pnpm preview`
      // opt out of remote bindings, so they keep using the local D1 in `.wrangler/state`.
      "remote": true,
    },
    {
      // The SEO analyzer's time-series data (score history, Search Console imports, rank
      // history, 404 logs), kept out of the main database. The plugin owns the schema:
      // `pnpm seo-store:migrate` (local) / `pnpm seo-store:migrate:remote` apply it, and
      // the store also applies it on first use. Retention prunes it daily (Cron Trigger).
      "binding": "SEO_D1",
      "database_name": "cargo-template-seo",
      // PLACEHOLDER: create the database (`wrangler d1 create cargo-template-seo`) and put
      // its id here. Until then, deploys and `seo-store:migrate:remote` fail on this binding.
      // Local dev and `pnpm preview` work with it as is (local D1 in `.wrangler/state`).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "cargo-template-media",
    },
  ],
  // Rate limits for the SEO analyzer's endpoints, shared by every isolate in a Cloudflare
  // location (the plugin's own limiters are per isolate). Limits mirror `SEO_RATE_LIMITS`
  // in the plugin; see src/plugins/seoRateLimit.ts. `namespace_id` is account-wide: give
  // each Worker its own ids, or they share counters.
  "ratelimits": [
    {
      "name": "SEO_RATE_LIMIT_EXPENSIVE",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "SEO_RATE_LIMIT_AUDIT_POLL",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "SEO_RATE_LIMIT_AI_INTERACTIVE",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
}
