{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cargo-template",
  // Custom server entry: TanStack Start's `fetch` plus a `scheduled` handler for the cron below.
  "main": "src/server.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // Runs the scheduled Payload jobs (`scheduled` in src/server.ts). Every 5 minutes matches
  // the SEO analyzer's `auditCron`, which continues dashboard audits that paused between
  // steps; the other tasks have their own schedules on top of it.
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "cargo-template",
      // The template's own database. Replace it with yours (see README > Deployment).
      "database_id": "29e40af9-e230-4c28-a622-c337ca02fbf4",
      // Lets `pnpm migrate:remote` reach the real database. Local dev and `pnpm preview`
      // opt out of remote bindings, so they keep using the local D1 in `.wrangler/state`.
      "remote": true,
    },
    {
      // The SEO analyzer's time-series data (score history, Search Console imports, rank
      // history, 404 logs), kept out of the main database. The plugin owns the schema:
      // `pnpm seo-store:migrate` (local) / `pnpm seo-store:migrate:remote` apply it, and
      // the store also applies it on first use. Retention prunes it daily (Cron Trigger).
      "binding": "SEO_D1",
      "database_name": "cargo-template-seo",
      // The template's own database, like `D1` above. Replace it with yours
      // (`wrangler d1 create <name>`). Local dev and `pnpm preview` use the local D1 in
      // `.wrangler/state`.
      "database_id": "bf11c24a-599f-42c8-b700-de5f56c3a377",
      "remote": true,
    },
  ],
  // A/B experiment measurement (src/plugins/abMeasurement.ts): one data point per impression
  // and per conversion, no personal data. Datasets are created on first write; no setup.
  // Local dev and tests have no real dataset, and the Variants panel reads results through the
  // SQL API (AB_ANALYTICS_ACCOUNT_ID / AB_ANALYTICS_API_TOKEN in .env.schema).
  "analytics_engine_datasets": [
    {
      "binding": "AB_ANALYTICS",
      "dataset": "cargo_ab",
    },
    // The assistant's audit log (#68): one data point per write it applied (user, tool,
    // collection, document id, conversation, model; no content). Written by the conversation
    // Durable Object (src/server.ts) and, under Node, by the plugin's `audit` option. Query it
    // with the SQL API: SELECT blob1 AS user, blob2 AS tool, … FROM cargo_assistant_audit.
    {
      "binding": "ASSISTANT_AUDIT",
      "dataset": "cargo_assistant_audit",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "cargo-template-media",
    },
  ],
  // Rate limits for the SEO analyzer's endpoints, shared by every isolate in a Cloudflare
  // location (the plugin's own limiters are per isolate). Limits mirror `SEO_RATE_LIMITS`
  // in the plugin; see src/plugins/seoRateLimit.ts. `namespace_id` is account-wide: give
  // each Worker its own ids, or they share counters.
  "ratelimits": [
    {
      "name": "SEO_RATE_LIMIT_EXPENSIVE",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "SEO_RATE_LIMIT_AUDIT_POLL",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "SEO_RATE_LIMIT_AI_INTERACTIVE",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 },
    },
    // A/B conversions (`POST /api/_ab/convert`, unauthenticated), per client IP: a visitor
    // converts once per experiment, so this only stops a script that drops the dedupe cookie.
    // Generous enough for visitors behind one shared IP (an office, a carrier NAT).
    // See abConversionRateLimit in src/plugins/abMeasurement.ts.
    {
      "name": "AB_RATE_LIMIT_CONVERT",
      "namespace_id": "1004",
      "simple": { "limit": 20, "period": 60 },
    },
    // Assistant chat turns (`POST /api/assistant/chat`, a send or an approval), per admin user.
    // A turn is up to 10 model calls; this only brakes a runaway client. The real spend cap is
    // the credit limit on the OpenRouter key. See src/plugins/assistantRateLimit.ts.
    {
      "name": "ASSISTANT_RATE_LIMIT",
      "namespace_id": "1005",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  // The admin assistant (packages/payload-plugin-assistant): one Durable Object per conversation
  // (transcript, runs, approvals, stream log, in its own SQLite: nothing in D1) and one per user
  // listing their conversations. The classes are re-exported from src/server.ts. The binding
  // names ASSISTANT_INDEX and ASSISTANT_SELF are fixed: the conversation object reads them.
  "durable_objects": {
    "bindings": [
      { "name": "ASSISTANT_CONVERSATIONS", "class_name": "AssistantConversation" },
      { "name": "ASSISTANT_INDEX", "class_name": "AssistantConversationIndex" },
    ],
  },
  // Durable Object class lifecycle, declaratively (Wrangler's recommendation for new Workers,
  // instead of the `migrations` array; the two are mutually exclusive, and a Worker deployed
  // with `exports` can't go back). `wrangler deploy` creates the namespaces on first deploy;
  // `wrangler versions upload` can't. Storage is fixed once created: SQLite.
  "exports": {
    "AssistantConversation": { "type": "durable-object", "storage": "sqlite" },
    "AssistantConversationIndex": { "type": "durable-object", "storage": "sqlite" },
  },
  // The assistant's tools: the conversation object calls this Worker's own `POST /api/mcp`
  // through a service binding, with the admin's cookie (no public URL, no network hop).
  // `service` must be this Worker's `name`.
  "services": [{ "binding": "ASSISTANT_SELF", "service": "cargo-template" }],
  "env": {
    // A separate Worker for trying deploy-only behaviour (Durable Objects, service bindings,
    // rate limits) without touching production: its own D1s, R2 bucket, Durable Object
    // namespaces, rate-limit counters and Analytics Engine dataset. `pnpm run deploy:staging`
    // builds with CLOUDFLARE_ENV=staging; see README > Deploying to staging. Wrangler doesn't
    // inherit bindings into an environment, so every binding above is repeated here (same
    // binding names, `-staging` resources). `exports`, `triggers` and `observability` are inherited.
    "staging": {
      "name": "cargo-template-staging",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "cargo-template-staging",
          "database_id": "7aa78ce1-419c-4069-b0af-09a012b91d9e",
          "remote": true,
        },
        {
          "binding": "SEO_D1",
          "database_name": "cargo-template-seo-staging",
          "database_id": "cdf1d01a-92e6-44f0-82d1-dca950d4f8ff",
          "remote": true,
        },
      ],
      "analytics_engine_datasets": [
        { "binding": "AB_ANALYTICS", "dataset": "cargo_ab_staging" },
        { "binding": "ASSISTANT_AUDIT", "dataset": "cargo_assistant_audit_staging" },
      ],
      "r2_buckets": [{ "binding": "R2", "bucket_name": "cargo-template-media-staging" }],
      // Same limits as production, on their own counters (namespace ids are account-wide).
      "ratelimits": [
        {
          "name": "SEO_RATE_LIMIT_EXPENSIVE",
          "namespace_id": "1101",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "SEO_RATE_LIMIT_AUDIT_POLL",
          "namespace_id": "1102",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "SEO_RATE_LIMIT_AI_INTERACTIVE",
          "namespace_id": "1103",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "AB_RATE_LIMIT_CONVERT",
          "namespace_id": "1104",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "ASSISTANT_RATE_LIMIT",
          "namespace_id": "1105",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "ASSISTANT_CONVERSATIONS", "class_name": "AssistantConversation" },
          { "name": "ASSISTANT_INDEX", "class_name": "AssistantConversationIndex" },
        ],
      },
      // The staging Worker calls itself, never production.
      "services": [{ "binding": "ASSISTANT_SELF", "service": "cargo-template-staging" }],
    },
  },
}
