{
  // Type-checks tests (and sources) without emitting. Package tsconfigs exclude __tests__.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    "paths": {
      "@cargo/onpage-core": ["./core/src/index.ts"],
      "@cargo/onpage-core/payload": ["./core/src/payload.ts"],
      "@cargo/onpage-core/testing": ["./core/src/testing.ts"],
      "@cargo/onpage-plugin": ["./plugin/src/index.ts"],
      "@cargo/onpage-plugin/admin": ["./plugin/src/admin/index.ts"],
      "@cargo/onpage-react": ["./react/src/index.ts"],
      "@cargo/onpage-react/annotations": ["./react/src/annotations.ts"],
      "@cargo/onpage-react/client": ["./react/src/OnPageClient.tsx"],
      "@cargo/onpage-react/editor-kit": ["./react/src/editor-kit.ts"],
      "@cargo/onpage-react/locales/*": ["./react/src/locales/*.ts"],
      "@cargo/onpage-lexical": ["./lexical/src/index.ts"],
      "@cargo/onpage-lexical/editor": ["./lexical/src/editor.ts"],
      "@cargo/onpage-tanstack-start": ["./tanstack-start/src/index.tsx"],
      "@cargo/onpage-tanstack-start/client": ["./tanstack-start/src/client.tsx"],
      "@cargo/onpage-tanstack-start/session": ["./tanstack-start/src/session.server.ts"]
    }
  },
  "include": ["*/src", "vitest.config.ts", "vitest.setup.ts"]
}
