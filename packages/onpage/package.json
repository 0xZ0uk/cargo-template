{
  "name": "@shipment/onpage",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for Shipment's fork of payload-onpage: shared tests, lint and type checks over packages/onpage/*.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@shipment/onpage-core": "workspace:*",
    "@shipment/onpage-lexical": "workspace:*",
    "@shipment/onpage-plugin": "workspace:*",
    "@shipment/onpage-react": "workspace:*",
    "@shipment/onpage-tanstack-start": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@payloadcms/db-sqlite": "catalog:",
    "@payloadcms/translations": "catalog:",
    "@payloadcms/ui": "catalog:",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.12.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "lexical": "catalog:",
    "payload": "catalog:",
    "prettier": "^3.9.10",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
