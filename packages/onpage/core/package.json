{
  "name": "@cargo/onpage-core",
  "version": "0.7.0",
  "private": true,
  "description": "Cargo's fork of payload-onpage core: document refs, schema, field operations, stega codec, autosave and the editor session, plus the port interfaces adapters implement.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./payload": {
      "types": "./dist/payload.d.ts",
      "default": "./dist/payload.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
