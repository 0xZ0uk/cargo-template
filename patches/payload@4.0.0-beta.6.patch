+// Patched (pnpm patch): Cloudflare Workers rejects PBKDF2 above 100,000 iterations
+// (cloudflare/workerd#1346), and upstream hardcodes 600,000. New hashes use 100,000 in the
+// format proposed upstream (payloadcms/payload#18461), which embeds the parameters so a
+// future Payload with that fix verifies them natively. Upstream v1 hashes (600,000) still
+// verify where the runtime allows it, and are rehashed on the next successful login.
+const currentPasswordHashIterations = 100000;
 const currentPasswordHashKeyLength = 32;
+const currentPasswordHashPrefix = `pbkdf2-sha256-v2-i${currentPasswordHashIterations}-l${currentPasswordHashKeyLength}:`;
